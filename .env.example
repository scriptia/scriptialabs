NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://scriptialabs.com
NEXT_TELEMETRY_DISABLED=1

# On Vercel, DATABASE_URL is injected by the Neon marketplace integration.
# Used by the internal panel AND by the public site's product and legal pages
# (ADR-013). Those pages are ISR-cached, so a database outage degrades them to
# stale rather than down.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the internal session cookie. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SESSION_SECRET=

# Shared secret for POST /api/ingest/bets, the one route the discovery pipeline
# calls to push a week's evaluated bets onto the board (see ADR-011). Sent as
# `Authorization: Bearer <token>`. Leave unset to disable the endpoint — it
# answers 503 rather than accepting anything.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# Shared secret for most of /api/content-engine/*, read/written by Claude
# Code Skills (see ADR-012). Same Bearer scheme and same 503-if-unset failure
# mode as INGEST_TOKEN. NOT used by POST /apps/onboard — see
# BRAND_AGENT_API_TOKEN below, a deliberately separate token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_ENGINE_API_TOKEN=

# Shared secret for POST /api/content-engine/apps/onboard only. Kept separate
# from CONTENT_ENGINE_API_TOKEN on purpose: BRAND-AGENT (another team's
# service, provisions new apps) and the Skills (read/write content for apps
# that already exist) are distinct external consumers with distinct
# lifecycles — rotating one token should never require rotating the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRAND_AGENT_API_TOKEN=

# Not read by this Next.js app itself — it's the base URL the Content Engine
# Skills (skills/*/SKILL.md) use to reach /api/content-engine/*, since they run
# outside this process. Documented here anyway so every env var this project
# depends on lives in one place. Defaults to http://localhost:3000 in dev.
CONTENT_ENGINE_API_BASE=http://localhost:3000

# Sends the "task is overdue" reminder email. https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend.
EMAIL_FROM=tasks@scriptialabs.com

# Shared secret for the Vercel Cron endpoints — GET /api/cron/overdue-tasks
# (daily) and GET /api/cron/reap-runs (every 10 minutes); see vercel.json. Sent
# as `Authorization: Bearer <token>`. Leave unset to disable them — they answer
# 503 rather than accepting anything.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Lets product-agent's orchestrator/runner.py claim queued pipeline runs and
# report on them (heartbeat, events, complete, asset upload). Leave unset to
# disable the queue surface entirely — it answers 503.
PIPELINE_RUNNER_TOKEN=

# Lets a finished run publish a product to the PUBLIC site via
# POST /api/ingest/products. Deliberately separate from PIPELINE_RUNNER_TOKEN:
# polling a queue and overwriting a live public page have different blast radii
# and should rotate independently — the same reasoning that keeps
# BRAND_AGENT_API_TOKEN separate from CONTENT_ENGINE_API_TOKEN.
PRODUCT_INGEST_TOKEN=

# Injected by the Vercel Blob integration. Stores product icons, logos and
# screenshots; the database keeps only the CDN URL. Without it the asset-upload
# route answers 503 and a product publishes without images rather than failing.
BLOB_READ_WRITE_TOKEN=

# Powers /internal/content-engine/carousels (generateCarousel Server Action) —
# calls OpenAI's Images API (gpt-image-2) directly to generate a whole
# carousel's slide images. Leave unset to disable: the form fails clean with
# a message in the UI instead of a 500. https://platform.openai.com/api-keys
OPENAI_API_KEY=
