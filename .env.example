NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://scriptialabs.com
NEXT_TELEMETRY_DISABLED=1

# Internal panel (/internal) only — the public site never reads the database.
# On Vercel, DATABASE_URL is injected by the Neon marketplace integration.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signs the internal session cookie. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SESSION_SECRET=

# Shared secret for POST /api/ingest/bets, the one route the discovery pipeline
# calls to push a week's evaluated bets onto the board (see ADR-011). Sent as
# `Authorization: Bearer <token>`. Leave unset to disable the endpoint — it
# answers 503 rather than accepting anything.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# Shared secret for most of /api/content-engine/*, read/written by Claude
# Code Skills (see ADR-012). Same Bearer scheme and same 503-if-unset failure
# mode as INGEST_TOKEN. NOT used by POST /apps/onboard — see
# BRAND_AGENT_API_TOKEN below, a deliberately separate token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_ENGINE_API_TOKEN=

# Shared secret for POST /api/content-engine/apps/onboard only. Kept separate
# from CONTENT_ENGINE_API_TOKEN on purpose: BRAND-AGENT (another team's
# service, provisions new apps) and the Skills (read/write content for apps
# that already exist) are distinct external consumers with distinct
# lifecycles — rotating one token should never require rotating the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRAND_AGENT_API_TOKEN=

# Not read by this Next.js app itself — it's the base URL the Content Engine
# Skills (skills/*/SKILL.md) use to reach /api/content-engine/*, since they run
# outside this process. Documented here anyway so every env var this project
# depends on lives in one place. Defaults to http://localhost:3000 in dev.
CONTENT_ENGINE_API_BASE=http://localhost:3000
